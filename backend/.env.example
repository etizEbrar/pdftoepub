# Copy to .env and adjust as needed. All of these have safe defaults; a normal
# conversion works with an empty .env (or no .env at all).

# development | staging | production
# Production hides the interactive API docs, enables HSTS and binds all
# interfaces so a container health check can reach the process.
ENVIRONMENT=development

HOST=127.0.0.1
PORT=8000

# Where uploads, page images and generated EPUBs live. Everything under here is
# temporary and swept on the TTL below.
# DATA_DIR=/data

MAX_UPLOAD_MB=200
# Hard ceiling on pages, so a crafted PDF cannot occupy a worker for hours.
MAX_PAGE_COUNT=2000
# Wall-clock limit for one conversion.
CONVERSION_TIMEOUT_SECONDS=1800
# Outside limit before an abandoned job's files *and* database row are deleted.
# A job the client downloads is deleted immediately, long before this.
JOB_TTL_HOURS=24
JOB_CONCURRENCY=2

# Abuse protection, counted per client IP in process memory. Starting a
# conversion is the expensive operation; the per-minute limit is a flood
# backstop that must stay well clear of normal progress polling.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_REQUESTS_PER_MINUTE=600

# Browser origins allowed to call the API. Empty is correct for a native-app
# backend — the iOS client is not subject to CORS.
CORS_ALLOW_ORIGINS=

# AI is optional and OFF by default. Leave as "none" for $0-per-book, fully
# local/deterministic conversion. "local" enables free, no-network heuristic
# review of low-confidence blocks. "anthropic" enables cloud review ONLY if
# ANTHROPIC_API_KEY is also set below — you pay for your own usage.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CONFIDENCE_THRESHOLD=0.70

# OCR — local Tesseract only. No key, no network, no per-page cost.
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_DPI=300
# Words below this Tesseract confidence are discarded rather than trusted.
OCR_MIN_WORD_CONFIDENCE=40
# A page scoring below this is preserved as an image instead of becoming text.
# Kept above the mid-60s band where upside-down Latin scores confidently wrong.
OCR_MIN_REGION_CONFIDENCE=75
# Above this the upright pass is trusted and rotated retries are skipped.
OCR_CONFIDENT_ACCEPT_THRESHOLD=88

# Below these, a faithful image of the source region replaces a guessed structure.
TABLE_MIN_CONFIDENCE=0.70
FORMULA_MIN_CONFIDENCE=0.70
FALLBACK_RENDER_DPI=200

EPUBCHECK_BINARY=epubcheck
